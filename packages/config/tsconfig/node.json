{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "verbatimModuleSyntax": false,
    "noEmit": false,
    "outDir": "./dist",
    "sourceMap": true
  }
}
